{
  "manifest_version": 3,
  "name": "AI Bookmark Organizer",
  "version": "0.3.0",
  "description": "Local-first bookmark review, canonical categories and recoverable organization.",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open AI Bookmark Organizer"
  },
  "options_page": "dashboard.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
